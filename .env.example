# ================================
# DGEN Server Environment Variables
# ================================
# Copy this file to .env and fill in your values
# These are the minimal required variables for both development and production

# Environment (REQUIRED)
NODE_ENV=development  # Use 'production' for production deployments

# Server Configuration (REQUIRED)
PORT=3119  # Railway will override this automatically

# Security Keys (REQUIRED)
# Development: Can use simple values like below
# Production: Generate with `openssl rand -hex 32` for JWT_SECRET (must be 64+ chars)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_PASSWORD=change-this-admin-password  # Must be 12+ characters in production

# CORS Configuration (REQUIRED)
# Development: Use localhost
# Production: Use your actual domain(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# Database - Redis (REQUIRED)
# Development: Use local Redis, configure via REDIS_PASSWORD/REDIS_TLS
# Production: Railway provides the Redis credentials automatically
REDIS_PASSWORD=
REDIS_TLS=false

# HTTPS (Production only)
# Railway handles HTTPS automatically, set to 'true' in production
HTTPS=false  # Set to 'true' for production

# Reverse Proxy (Production only)
# Set to 'true' when running behind a reverse proxy (Railway, Cloudflare, Nginx)
# Required for correct client IPs and HTTPS enforcement behind the proxy
TRUST_PROXY=false

# Cloudflare Proxy (Production only)
# Set to 'true' if behind Cloudflare to trust cf-connecting-ip header for rate limiting
# WARNING: Only enable if actually behind Cloudflare, otherwise attackers can spoof IPs
TRUST_CLOUDFLARE=false

# Blockstream Esplora API (OPTIONAL - enterprise tier)
# Leave empty to use public API (rate limited)
# Blockstream Enterprise OAuth (required for access token flow)
BLOCKSTREAM_CLIENT_ID=
BLOCKSTREAM_CLIENT_SECRET=
BLOCKSTREAM_TOKEN_URL=https://login.blockstream.com/realms/blockstream-public/protocol/openid-connect/token
BLOCKSTREAM_SCOPE=openid

# Enterprise Esplora endpoints (set to enterprise host when using access tokens)
# If you are NOT using enterprise access, replace these with public endpoints:
# BITCOIN_ESPLORA_URL=https://blockstream.info/api
# LIQUID_ESPLORA_URL=https://blockstream.info/liquid/api
BITCOIN_ESPLORA_URL=https://enterprise.blockstream.info/api
LIQUID_ESPLORA_URL=https://enterprise.blockstream.info/liquid/api

# Breez Liquid endpoints (required for Breez-only routes like /v1/server_recipient, /v2/waterfalls)
# Keep this pointing at Breez regardless of enterprise Esplora settings.
LIQUID_BREEZ_URL=https://lq1.breez.technology/liquid/api

# Optional: Breez API key/header for Breez-only endpoints (if Breez requires auth)
# Default header is X-API-KEY; set BREEZ_API_KEY_HEADER=Authorization to use Bearer auth.
BREEZ_API_KEY=
BREEZ_API_KEY_HEADER=X-API-KEY

# Esplora proxy tuning (optional)
# Cap the number of endpoint stats tracked in memory
ESPLORA_METRICS_MAX_ENDPOINTS=200
# Set to "false" to disable tip-gated reuse of scripthash UTXO stale cache
ESPLORA_TIP_GATE_SCRIPTHASH_UTXO=true
# Set to "false" to disable tip-gated reuse of confirmed address/scripthash tx lists
ESPLORA_TIP_GATE_TXS=true
