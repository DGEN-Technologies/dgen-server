# ================================
# DGEN Server Environment Variables
# ================================
# Copy this file to .env and fill in your values
# These are the minimal required variables for both development and production

# Environment (REQUIRED)
NODE_ENV=development  # Use 'production' for production deployments

# Server Configuration (REQUIRED)
PORT=3119  # Railway will override this automatically

# Security Keys (REQUIRED)
# Development: Can use simple values like below
# Production: Generate with `openssl rand -hex 32` for JWT_SECRET (must be 64+ chars)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_PASSWORD=change-this-admin-password  # Must be 12+ characters in production

# CORS Configuration (REQUIRED)
# Development: Use localhost
# Production: Use your actual domain(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# Database - Redis URLs (REQUIRED)
# Development: Use local Redis
# Production: Use Railway Redis URLs (Railway provides these automatically)
REDIS_URL=redis://localhost:6379
ARCHIVE_REDIS_URL=redis://localhost:6379

# HTTPS (Production only)
# Railway handles HTTPS automatically, set to 'true' in production
HTTPS=false  # Set to 'true' for production
