# ================================
# DGEN Server Environment Variables
# ================================
# Copy this file to .env for local development
# For production, set these in your deployment platform (Railway)

# Basic server configuration (REQUIRED)
NODE_ENV=development
URL=http://localhost:3119
PORT=3119
WS_PORT=3120
HOST=0.0.0.0

# CORS Configuration - comma-separated list of allowed origins
# For production, add your Netlify domain here
# Example: CORS_ALLOWED_ORIGINS=https://your-app.netlify.app,https://your-custom-domain.com
# Include both HTTP and HTTPS for local development (HTTPS needed for Breez SDK WebAssembly):
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# Database (Redis/KeyDB) - REQUIRED for local development
# Install Redis locally or use Docker: docker run -p 6379:6379 redis
DATABASE_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-secure-redis-password

# Authentication (REQUIRED for auth features)
# For local dev, you can use simple values like 'dev-secret' and 'admin'
JWT_SECRET=dev-secret-key
ADMIN_PASSWORD=admin
SUPPORT_EMAIL=support@yourdomain.com

# Lightning Network handled by browser SDK (dgen-ui)
