# Production Environment Configuration
# Copy to .env.production and fill in your values

# Environment
NODE_ENV=production

# Security Keys - MUST BE UNIQUE AND STRONG!
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_64_CHARACTER_RANDOM_HEX_STRING_DO_NOT_USE_DEFAULT
WALLET_ENCRYPTION_KEY=DIFFERENT_64_CHARACTER_RANDOM_HEX_STRING_FROM_JWT_SECRET
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD

# CORS Configuration - Replace with your domain
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Server Configuration
HOST=127.0.0.1  # Bind to localhost if using reverse proxy
PORT=3119

# HTTPS/TLS (Required for production)
HTTPS=true
SSL_CERT_PATH=/path/to/your/cert.pem
SSL_KEY_PATH=/path/to/your/key.pem

# Database URLs
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_TLS=true

# API Keys
BREEZ_API_KEY=your_breez_api_key_here

# Optional: External Services
SENTRY_DSN=your_sentry_dsn_for_error_tracking
LOG_LEVEL=info

# Performance
MAX_CONNECTIONS=200
CONNECTION_TIMEOUT=30000

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
SESSION_TIMEOUT=86400000  # 24 hours in ms